[MAIN]
py-version=3.12

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    duplicate-code,
    redefined-outer-name

[FORMAT]
max-line-length=100

[DESIGN]
max-attributes=12

[TYPECHECK]
ignored-classes=State,Wave_read,Wave_write
